-# Environment variables for Social Media API
# Docs: https://docs.djangoproject.com/en/stable/ref/settings/

# Required in production; generate a strong value
SECRET_KEY=replace-with-a-strong-secret

# Development defaults; set to False in production
DEBUG=True

# Comma-separated hostnames
# Local dev:
ALLOWED_HOSTS=127.0.0.1,localhost
# Render example: set to your domain, e.g.
# ALLOWED_HOSTS=your-service.onrender.com

# Optional: set when using managed Postgres on Render
# Get URL from Render Postgres dashboard:
# https://render.com/docs/databases#connecting-to-your-database
# Example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME